---
import BlogList from '@/components/BlogList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/content';

const posts = await getPosts();
---

<BaseLayout title="Posts" description="Writing by Rakesh Kumar Pradhan.">
  <section class="collection-page" aria-labelledby="posts-title">
    <h1 id="posts-title">Blog</h1>
    {
      posts.length > 0 ? (
        <BlogList posts={posts} />
      ) : (
        <p class="empty-state">Writing will appear here as it is published.</p>
      )
    }
  </section>
</BaseLayout>
