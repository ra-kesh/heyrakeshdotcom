---
import site from '@/config/site';

const socialLinks = site.author.links.filter(({ href }) =>
  href.startsWith('http'),
);
---

<div class="intro-copy">
  {site.intro.map((paragraph) => <p>{paragraph}</p>)}
  {
    site.author.email && (
      <div class="intro-copy__contact">
        <p>
          <a href={`mailto:${site.author.email}`}>{site.author.email}</a> is the
          best way to reach me.
        </p>
        {socialLinks.length > 0 && (
          <p>
            You can also find me on{' '}
            {socialLinks.map((item, index) => (
              <>
                {index > 0 &&
                  (index === socialLinks.length - 1 ? ', and ' : ', ')}
                <a href={item.href}>{item.label}</a>
              </>
            ))}
            .
          </p>
        )}
      </div>
    )
  }
</div>

<style>
  .intro-copy {
    display: grid;
    gap: 1.5rem;
  }

  .intro-copy__contact {
    display: block;
  }

  .intro-copy__contact p + p {
    margin-top: 1.25rem;
  }

  .intro-copy p {
    margin: 0;
  }

  .intro-copy a {
    color: var(--text);
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.2em;
  }

  .intro-copy a:hover {
    color: var(--accent);
  }
</style>
