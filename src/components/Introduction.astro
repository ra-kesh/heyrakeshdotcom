---
import site from '@/config/site';

const socialLinks = site.author.links.filter(({ href }) =>
  href.startsWith('http'),
);
// The first mention of the agency in the intro links to its site.
const [firstParagraph = '', ...otherParagraphs] = site.intro;
const agencyAt = firstParagraph.indexOf(site.agency.name);
---

<div class="intro-copy">
  {
    agencyAt === -1 ? (
      <p>{firstParagraph}</p>
    ) : (
      <p>
        {firstParagraph.slice(0, agencyAt)}
        <a
          href={site.agency.url}
          data-cuelume-press="press"
          data-cuelume-toggle="release"
        >
          {site.agency.name}
        </a>
        {firstParagraph.slice(agencyAt + site.agency.name.length)}
      </p>
    )
  }
  {otherParagraphs.map((paragraph) => <p>{paragraph}</p>)}
  {
    site.author.email && (
      <div class="intro-copy__contact">
        <p>
          <a
            href={`mailto:${site.author.email}`}
            data-cuelume-press="press"
            data-cuelume-toggle="release"
          >
            {site.author.email}
          </a>{' '}
          is the best way to reach out to me.
        </p>
        {socialLinks.length > 0 && (
          <p>
            You can also find me on{' '}
            {socialLinks.map((item, index) => (
              <>
                {index > 0 &&
                  (index === socialLinks.length - 1 ? ', and ' : ', ')}
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cuelume-press="press"
                  data-cuelume-toggle="release"
                >
                  {item.label}
                </a>
              </>
            ))}
            .
          </p>
        )}
      </div>
    )
  }
</div>

<style>
  .intro-copy {
    display: grid;
    gap: 1.5rem;
  }

  .intro-copy__contact {
    display: block;
  }

  .intro-copy__contact p + p {
    margin-top: 1.25rem;
  }

  .intro-copy p {
    margin: 0;
  }

  .intro-copy a {
    color: var(--text);
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.2em;
  }

  .intro-copy a:hover {
    color: var(--accent);
  }
</style>
