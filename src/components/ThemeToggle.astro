<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="Switch to dark mode"
  aria-pressed="false"
  title="Switch to dark mode"
>
  <svg
    class="theme-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="19"
    height="19"
    viewBox="0 0 20 20"
    aria-hidden="true"
  >
    <circle class="theme-icon-ring" cx="10" cy="10" r="6.75"></circle>
    <path
      class="theme-icon-phase"
      d="M10 3.25a6.75 6.75 0 0 1 0 13.5 3.65 6.75 0 0 0 0-13.5Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: absolute;
    top: 1.35rem;
    right: 1.5rem;
    z-index: 10;
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 120ms ease;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .theme-toggle:focus-visible {
    border-radius: 0.125rem;
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  .theme-icon {
    display: block;
    overflow: visible;
    transition: transform 200ms ease;
  }

  .theme-icon-ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.45;
  }

  .theme-icon-phase {
    fill: currentColor;
    opacity: 0.62;
    transform-origin: center;
    transition: opacity 120ms ease;
  }

  :global([data-theme='dark']) .theme-icon {
    transform: rotate(180deg);
  }

  :global([data-theme='dark']) .theme-icon-phase {
    opacity: 0.76;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .theme-icon,
    .theme-icon-phase {
      transition: none;
    }
  }
</style>
